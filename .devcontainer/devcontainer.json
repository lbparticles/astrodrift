{
  "name": "astrodrift-cuda",
  "build": {
    "dockerfile": "../env/Dockerfile.modern",
    "context": ".."
  },
  "runArgs": [
    "--gpus=all"
  ],
  "remoteUser": "ubuntu",
  "updateRemoteUserUID": true,
  "postCreateCommand": "bash -c 'cd /workspaces/astrodrift && cargo oxide setup && ./build-cuda-oxide-kernels.sh'",
  "workspaceFolder": "/workspaces",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/astrodrift,type=bind",
  "mounts": [
    "source=/home/jack/src/cuda-oxide,target=/workspaces/cuda-oxide,type=bind"
  ],
  "containerEnv": {
    "CUDA_HOME": "/usr/local/cuda",
    "CUDA_PATH": "/usr/local/cuda",
    "CUDA_TOOLKIT_PATH": "/usr/local/cuda",
    "CUDA_OXIDE_LLC": "/usr/bin/llc-21",
    "LIBCLANG_PATH": "/usr/lib/llvm-21/lib",
    "LLVM_CONFIG_PATH": "/usr/bin/llvm-config-21",
    "NVIDIA_DRIVER_CAPABILITIES": "all",
    "UV_PROJECT_ENVIRONMENT": "/opt/astrodrift-venv"
  },
  "remoteEnv": {
    "LD_LIBRARY_PATH": "/usr/local/cuda/nvvm/lib64:${containerEnv:LD_LIBRARY_PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "ms-python.python"
      ],
      "settings": {
        "rust-analyzer.linkedProjects": [
          "/workspaces/astrodrift/Cargo.toml",
          "/workspaces/cuda-oxide/Cargo.toml"
        ],
        "python.defaultInterpreterPath": "/opt/astrodrift-venv/bin/python"
      }
    }
  }
}
